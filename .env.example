# Server Configuration
PORT=5000

# PostgreSQL Database Connection URL (Neon, Supabase, Render, Local Postgres, ...)
DATABASE_URL=postgresql://username:password@localhost:5432/ecommerce_db?sslmode=require

# JWT Authentication Secret & Expiration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=1d

# Google Gemini API Key (Dùng cho chatbot tư vấn sản phẩm)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary (Dùng để upload hình ảnh sản phẩm)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
